{
  "name": "pixelwerk-desktop",
  "productName": "Pixelwerk",
  "version": "5.0.1",
  "description": "Pixelwerk – lokale Bildbearbeitung für Windows / offline image editor",
  "main": "src/main/main.cjs",
  "author": "www.perplex.click",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "electron .",
    "check": "node scripts/check.cjs",
    "test": "node --test tests/unit/*.test.cjs tests/integration/*.test.cjs",
    "test:e2e": "playwright test",
    "test:all": "npm run check && npm test && npm run test:e2e",
    "build:win:portable": "node scripts/build.cjs portable",
    "build:win:setup": "node scripts/build.cjs setup",
    "dist:win": "node scripts/build.cjs all",
    "release:hashes": "node scripts/hashes.cjs"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "7zip-bin": "5.2.0",
    "app-builder-lib": "26.18.0",
    "electron": "45.3.2",
    "electron-builder": "26.18.0"
  }
}
